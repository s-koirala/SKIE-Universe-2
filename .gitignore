# =====================================================================
# Sensitive (must never commit)
# =====================================================================
.env
.env.*
*.token
*.secret
*.pem
*.key
credentials.json
.credentials.json

# =====================================================================
# Python build / cache
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# =====================================================================
# Virtual environments
# =====================================================================
.venv/
venv/

# =====================================================================
# Data (gitignored by default; un-ignore specific subdirs as needed)
# NB: exclude directory *contents* (`X/*`, `X/**`) rather than the
# directory itself (`X/`) — git cannot re-include a file whose parent
# directory is excluded, so `!.gitkeep`-style negations only work with
# contents-level patterns (gitignore(5), PATTERN FORMAT).
# =====================================================================
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/_manifest.json
!data/expectations.yaml
!data/processed/_provenance/

# =====================================================================
# Artifacts and runs (gitignored; track via DVC or git-lfs if needed)
# =====================================================================
artifacts/**
!artifacts/**/
runs/**
!runs/**/
outputs/**
!outputs/**/

# =====================================================================
# Logs (ReproLogs are tracked manually only when referenced by a commit;
# use `git add -f` for individual ReproLog JSONs)
# =====================================================================
logs/**
!logs/**/

# Directory placeholders (last so they win over all excludes above)
!**/.gitkeep

# =====================================================================
# Notebooks (stripped via nbstripout)
# =====================================================================
.ipynb_checkpoints/

# =====================================================================
# OS / editor
# =====================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# =====================================================================
# Build/release
# =====================================================================
*.tar.gz
*.whl

# =====================================================================
# Allow-list (these match patterns above but ARE tracked)
# =====================================================================
!CITATION.cff
!manifest.json
